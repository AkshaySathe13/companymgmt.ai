  "components": [
    {
      "name": "Sign-in Button",
      "kind": "button",
      "description": "Primary demo login action.",
      "html": "<button class=\"ds-submit\">Sign in <span aria-hidden=\"true\">\u2192</span></button>",
      "css": ".ds-submit{font-family:var(--font-sans,\"Manrope Variable\",sans-serif);display:flex;justify-content:center;align-items:center;gap:12px;width:100%;padding:15px;border:0;border-radius:8px;background:#b199ec;color:#191023;font-size:13px;font-weight:750;cursor:pointer;}.ds-submit:hover{background:#c4aef8;}.ds-submit:focus-visible{outline:2px solid var(--accent,#b1a3ff);outline-offset:4px;}.ds-submit:disabled{opacity:.6;cursor:wait;}",
      "refersTo": "button-primary"
    },
    {
      "name": "Icon Button",
      "kind": "button",
      "description": "Topbar action with an accessible name.",
      "html": "<button class=\"ds-icon\" aria-label=\"Search navigation\"><svg width=\"19\" height=\"19\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" aria-hidden=\"true\"><circle cx=\"11\" cy=\"11\" r=\"8\"/><path d=\"m21 21-4.3-4.3\"/></svg></button>",
      "css": ".ds-icon{display:inline-flex;align-items:center;justify-content:center;width:36px;height:36px;border:0;border-radius:8px;background:transparent;color:var(--muted,#a3a1b5);cursor:pointer;}.ds-icon:hover{background:var(--raised,#22222e);color:var(--text,#efedf6);}.ds-icon:focus-visible{outline:2px solid var(--accent,#b1a3ff);outline-offset:4px;}@media(max-width:900px){.ds-icon{min-width:44px;height:44px;}}",
      "refersTo": "icon-button"
    },
    {
      "name": "Navigation Link",
      "kind": "nav",
      "description": "Inactive sidebar destination.",
      "html": "<a class=\"ds-nav\" href=\"#\"><svg width=\"19\" height=\"19\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" aria-hidden=\"true\"><path d=\"M12 8V4H8\"/><rect x=\"4\" y=\"8\" width=\"16\" height=\"12\" rx=\"2\"/><path d=\"M2 14h2m16 0h2M9 13v2m6-2v2\"/></svg><span>AI Agent</span></a>",
      "css": ".ds-nav{font-family:var(--font-sans,\"Manrope Variable\",sans-serif);display:flex;align-items:center;gap:11px;min-height:42px;padding:11px 12px;border-radius:8px;color:#b6b3c6;font-size:12px;font-weight:500;line-height:18px;text-decoration:none;transition:background .15s,color .15s;}.ds-nav:hover{background:#20202b;color:#f2effb;}.ds-nav:focus-visible{outline:2px solid var(--accent,#b1a3ff);outline-offset:4px;}.ds-nav.ds-nav-active{background:var(--accent-wash,#29243f);color:#d6cbff;}@media(max-width:900px){.ds-nav{min-height:44px;}}@media(prefers-reduced-motion:reduce){.ds-nav{transition:none;}}",
      "refersTo": "nav-item"
    },
    {
      "name": "Active Navigation Link",
      "kind": "nav",
      "description": "Current destination with a tinted selection surface.",
      "html": "<a class=\"ds-nav ds-nav-active\" href=\"#\" aria-current=\"page\"><svg width=\"19\" height=\"19\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" aria-hidden=\"true\"><path d=\"M12 8V4H8\"/><rect x=\"4\" y=\"8\" width=\"16\" height=\"12\" rx=\"2\"/><path d=\"M2 14h2m16 0h2M9 13v2m6-2v2\"/></svg><span>AI Agent</span></a>",
      "css": ".ds-nav{font-family:var(--font-sans,\"Manrope Variable\",sans-serif);display:flex;align-items:center;gap:11px;min-height:42px;padding:11px 12px;border-radius:8px;color:#b6b3c6;font-size:12px;font-weight:500;line-height:18px;text-decoration:none;transition:background .15s,color .15s;}.ds-nav:hover{background:#20202b;color:#f2effb;}.ds-nav:focus-visible{outline:2px solid var(--accent,#b1a3ff);outline-offset:4px;}.ds-nav.ds-nav-active{background:var(--accent-wash,#29243f);color:#d6cbff;}@media(max-width:900px){.ds-nav{min-height:44px;}}@media(prefers-reduced-motion:reduce){.ds-nav{transition:none;}}",
      "refersTo": "nav-item-active"
    },
    {
      "name": "Login Field",
      "kind": "input",
      "description": "Persistent label and native email input.",
      "html": "<label class=\"ds-label\" for=\"ds-email\">Email address</label><div class=\"ds-field\"><input id=\"ds-email\" type=\"email\" placeholder=\"you@company.com\" /></div>",
      "css": ".ds-label{font-family:var(--font-sans,\"Manrope Variable\",sans-serif);display:block;margin-bottom:9px;color:#ded2e9;font-size:12px;font-weight:550;}.ds-field{display:flex;align-items:center;padding:0 14px;height:48px;border:1px solid #43364e;border-radius:8px;background:#1c1822;}.ds-field:focus-within{border-color:#ac89cf;box-shadow:0 0 0 3px #ab88cd1a;}.ds-field input{font-family:var(--font-sans,\"Manrope Variable\",sans-serif);flex:1;min-width:0;width:100%;border:0;background:transparent;padding:12px 0;outline:none;color:#e4d9ee;font-size:13px;caret-color:var(--accent,#b1a3ff);}.ds-field input::placeholder{color:#8f8ca4;}@media(max-width:900px){.ds-field input{font-size:16px;}}",
      "refersTo": "input"
    },
    {
      "name": "Coming Soon Badge",
      "kind": "chip",
      "description": "Explicit destination placeholder status.",
      "html": "<span class=\"ds-status\"><span></span>Coming soon</span>",
      "css": ".ds-status{font-family:var(--font-sans,\"Manrope Variable\",sans-serif);display:inline-flex;align-items:center;gap:6px;white-space:nowrap;font-size:10px;border:1px solid #37313f;border-radius:6px;padding:5px 8px;color:#b6a9c8;}.ds-status>span{width:4px;height:4px;border-radius:50%;background:#b6a9c8;}",
      "refersTo": "status-badge"
    },
    {
      "name": "Destination Placeholder",
      "kind": "custom",
      "description": "Shared quiet content for every destination.",
      "html": "<section class=\"ds-coming\"><div class=\"ds-coming-icon\"><svg width=\"19\" height=\"19\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" aria-hidden=\"true\"><path d=\"M12 8V4H8\"/><rect x=\"4\" y=\"8\" width=\"16\" height=\"12\" rx=\"2\"/><path d=\"M2 14h2m16 0h2M9 13v2m6-2v2\"/></svg></div><h2>Coming soon</h2><p>This space is ready for what comes next.</p><div class=\"ds-rule\"></div><span>AI Agent</span></section>",
      "css": ".ds-coming{font-family:var(--font-sans,\"Manrope Variable\",sans-serif);display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;min-height:400px;padding:70px 20px 110px;background:var(--background,#101015);color:var(--text,#efedf6);}.ds-coming-icon{display:grid;place-items:center;width:78px;height:78px;background:#1e1b28;border:1px solid #383040;border-radius:22px;color:#b8a6db;}.ds-coming-icon svg{width:32px;height:32px;}.ds-coming h2{margin:26px 0 9px;font-size:30px;letter-spacing:-.03em;font-weight:600;}.ds-coming p{margin:0;font-size:13px;color:#a99bb9;line-height:1.7;}.ds-rule{width:28px;height:1px;background:#44384d;margin:25px 0 17px;}.ds-coming>span{font-size:11px;color:#b6a3c6;line-height:1.8;}@media(max-width:520px){.ds-coming{min-height:360px;padding:65px 0 90px;}.ds-coming h2{font-size:27px;}}"
    },
    {
      "name": "Account Popover",
      "kind": "custom",
      "description": "Demo identity and sign-out action.",
      "html": "<div class=\"ds-popover\"><strong>Demo workspace</strong><span>demo@companymgmt.ai</span><small>Preview session</small><button>Sign out</button></div>",
      "css": ".ds-popover{font-family:var(--font-sans,\"Manrope Variable\",sans-serif);min-width:250px;padding:18px;background:#20202b;border:1px solid #3b3548;border-radius:12px;box-shadow:0 15px 45px #0006;color:var(--text,#efedf6);}.ds-popover strong,.ds-popover span,.ds-popover small{display:block;margin-bottom:7px;}.ds-popover strong,.ds-popover span{font-size:12px;}.ds-popover span{color:#b4a8c5;}.ds-popover small{font-size:10px;color:#b4a8c5;}.ds-popover button{font-family:var(--font-sans,\"Manrope Variable\",sans-serif);width:100%;margin-top:16px;padding:12px 0 0;background:transparent;border:0;border-top:1px solid #3b3548;color:#ddd2eb;font-size:12px;text-align:left;cursor:pointer;}.ds-popover button:focus-visible{outline:2px solid var(--accent,#b1a3ff);outline-offset:4px;}",
      "refersTo": "popover"
    }
